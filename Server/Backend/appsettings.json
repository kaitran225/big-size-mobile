{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "RequireEmailVerified": false,
    "Jwt": {
      "Issuer": "BigFit.Backend",
      "Audience": "BigFit.Mobile",
      "AccessTokenMinutes": 30
    }
  },
  "Ai": {
    "OpenAiCompatible": {
      "BaseUrl": "https://api.groq.com/openai/v1",
      "Model": "openai/gpt-oss-120b",
      "MaxOutputTokens": 600
    }
  },
  "Email": {
    "Enabled": false,
    "Verification": {
      "BaseUrl": "https://big-fit-pgm-store.onrender.com/api/security"
    },
    "Otp": {
      "CodeLength": 6,
      "ExpiryMinutes": 10,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 45
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "BigFit",
      "EnableSsl": true
    }
  },
  "Payments": {
    "SePay": {
      "ApiBaseUrl": "https://bankhub-api-sandbox.sepay.vn",
      "EurToVndRate": 27000
    }
  },
  "AllowedHosts": "*"
}
