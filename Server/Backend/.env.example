ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
Database__ApplyMigrationsOnStartup=true
ConnectionStrings__Default=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
Auth__Jwt__SigningKey=replace-with-a-random-secret-at-least-32-bytes
Auth__Jwt__Issuer=BigFit.Backend
Auth__Jwt__Audience=BigFit.Mobile

# Optional OpenAI-compatible assistant settings. Keep the key private.
Ai__OpenAiCompatible__BaseUrl=https://api.openai.com/v1
Ai__OpenAiCompatible__ApiKey=
Ai__OpenAiCompatible__Model=
Ai__OpenAiCompatible__MaxOutputTokens=300

# Bank Hub sandbox. Keep the client secret, notify key, and account id private.
# The app does not read this file. Set the same keys with dotnet user-secrets.
# PublicBaseUrl is the public HTTPS origin SePay calls, without a trailing slash.
Payments__SePay__ApiBaseUrl=https://bankhub-api-sandbox.sepay.vn
Payments__SePay__ClientId=
Payments__SePay__ClientSecret=
Payments__SePay__IpnSecretKey=
Payments__SePay__PublicBaseUrl=https://big-fit-pgm-store.onrender.com
Payments__SePay__BankAccountXid=
Payments__SePay__EurToVndRate=27000
